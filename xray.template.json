{
  "log": { "loglevel": "warning" },
  "inbounds": [
    {
      "listen": "127.0.0.1",
      "port": 1080,
      "protocol": "socks",
      "settings": { "auth": "noauth", "udp": true }
    }
  ],
  "outbounds": [
    {
      "tag": "vmess-out",
      "protocol": "vmess",
      "settings": {
        "vnext": [
          {
            "address": "${VMESS_HOST}",
            "port": ${VMESS_PORT},
            "users": [
              { "id": "${VMESS_UUID}", "alterId": ${VMESS_ALTERID}, "security": "${VMESS_SECURITY}" }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "tcp",
        "security": "none"
      }
    }
  ],
  "routing": {
    "rules": [
      { "type": "field", "outboundTag": "vmess-out" }
    ]
  }
}
